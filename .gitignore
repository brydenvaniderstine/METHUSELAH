node_modules
build/
__pycache__/
*.pyc

# Secrets - never commit live credentials
.env
.env.local
.env.*.local

# Raw BLE pull outputs - bulky, kept locally only
# (paths below were "data/raw_pulls/" and "pipeline/data/logs/*.log" until
# 2026-09-14 -- neither matched the actual directories, so raw BLE payloads
# and daemon logs were never actually ignored; one raw pull file had already
# been committed as a result. See known_issues.md, 2026-09-14.)
pipeline/data/raw_pulls/
!pipeline/data/raw_pulls/**/README.md
.vercel
pipeline/logs/*.log
pipeline/data/logs/*.log
pipeline/data/bridge/gen3_latest.json
pipeline/data/bridge/bout_checkpoint.json
pipeline/data/bridge/last_synced_boot_ts.json
pipeline/data/raw_pulls/**/*.wake_state.json
